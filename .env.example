# Copy to .env and fill in. Never commit .env.

# Prisma (Supabase session pooler, port 5432)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres"

# Session signing. Use a long random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Public URL of the app. Used in password-reset emails.
APP_URL="http://localhost:3000"

# Gmail account used to send reset emails (use an App Password, not your login password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Demo sign-in buttons. They show automatically in development.
# Set ENABLE_DEMO_MODE=true to also show them on a deployed site.
ENABLE_DEMO_MODE="false"
# The admin demo exposes real user data, so keep this off on a shared database.
DEMO_ALLOW_ADMIN="false"
