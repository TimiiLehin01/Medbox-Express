generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String               @unique
  password            String
  role                UserRole             @default(CONSUMER)
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  pharmacy            Pharmacy?
  reviews             Review[]
  rider               Rider?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Pharmacy {
  id             String    @id @default(cuid())
  userId         String    @unique
  name           String
  address        String
  latitude       Float
  longitude      Float
  licenseDoc     String?
  cacDoc         String?
  verified       Boolean   @default(false)
  openTime       String?
  closeTime      String?
  deliveryRadius Float     @default(10.0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  reviews        Review[]
}

model Rider {
  id            String            @id @default(cuid())
  userId        String            @unique
  transportType String
  licenseDoc    String?
  bikeDoc       String?
  verified      Boolean           @default(false)
  latitude      Float?
  longitude     Float?
  availability  RiderAvailability @default(OFFLINE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orders        Order[]
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnings      RiderEarning[]
}

model Product {
  id                   String      @id @default(cuid())
  pharmacyId           String
  name                 String
  description          String?
  category             String
  price                Float
  quantity             Int
  expiryDate           DateTime?
  prescriptionRequired Boolean     @default(false)
  imageUrl             String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  orderItems           OrderItem[]
  pharmacy             Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@index([category])
}

model Order {
  id                String        @id @default(cuid())
  consumerId        String
  pharmacyId        String
  riderId           String?
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     String
  subtotal          Float
  deliveryFee       Float
  total             Float
  deliveryAddress   String
  deliveryLatitude  Float
  deliveryLongitude Float
  prescriptionUrl   String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paymentReference  String?
  consumer          User          @relation(fields: [consumerId], references: [id])
  pharmacy          Pharmacy      @relation(fields: [pharmacyId], references: [id])
  rider             Rider?        @relation(fields: [riderId], references: [id])
  items             OrderItem[]

  @@index([consumerId])
  @@index([pharmacyId])
  @@index([riderId])
  @@index([status])
  @@index([paymentReference])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model RiderEarning {
  id          String   @id @default(cuid())
  riderId     String
  amount      Float
  description String
  date        DateTime @default(now())
  rider       Rider    @relation(fields: [riderId], references: [id])

  @@index([riderId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  pharmacyId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([pharmacyId])
}

enum UserRole {
  CONSUMER
  PHARMACY
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  READY
  PICKED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RiderAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}
